            "\n",
            "==================================================\n",
            "           🛵 APLIKASI CARE-MOTOR 🛵\n",
            "  Computerized Automotive Reminder\n",
            "       and Maintenance Tracker\n",
            "==================================================\n",
            "\n",
            "========== MENU AWAL ==========\n",
            "1. Registrasi Akun Baru\n",
            "2. Login ke Akun\n",
            "3. Keluar dari Program\n",
            "===============================\n",
            "\n",
            "\n",
            "Program dihentikan oleh pengguna.\n"
          ]
        }
      ],
      "source": [
        "import hashlib\n",
        "import os\n",
        "import sqlite3\n",
        "from datetime import datetime\n",
        "\n",
        "# ==================================================\n",
        "# KONEKSI DATABASE\n",
        "# ==================================================\n",
        "\n",
        "DATABASE = \"care_motor.db\"\n",
        "\n",
        "\n",
        "def get_conn():\n",
        "    conn = sqlite3.connect(DATABASE)\n",
        "    conn.execute(\"PRAGMA foreign_keys = ON\")\n",
        "    return conn\n",
        "\n",
        "\n",
        "def buat_database():\n",
        "    conn = get_conn()\n",
        "    cursor = conn.cursor()\n",
        "\n",
        "    cursor.execute(\"\"\"\n",
        "        CREATE TABLE IF NOT EXISTS User (\n",
        "            id INTEGER PRIMARY KEY AUTOINCREMENT,\n",
        "            nama TEXT NOT NULL,\n",
        "            username TEXT NOT NULL UNIQUE,\n",
        "            password TEXT NOT NULL\n",
        "        )\n",
        "    \"\"\")\n",
        "\n",
        "    cursor.execute(\"\"\"\n",
        "        CREATE TABLE IF NOT EXISTS Kendaraan (\n",
        "            id INTEGER PRIMARY KEY AUTOINCREMENT,\n",
        "            user_id INTEGER NOT NULL,\n",
        "            nomor_polisi TEXT NOT NULL,\n",
        "            merk TEXT NOT NULL,\n",
        "            tipe TEXT NOT NULL,\n",
        "            tahun INTEGER NOT NULL,\n",
        "            kilometer_saat_ini INTEGER NOT NULL,\n",
        "            FOREIGN KEY (user_id) REFERENCES User(id) ON DELETE CASCADE\n",
        "        )\n",
        "    \"\"\")\n",
        "\n",
        "    cursor.execute(\"\"\"\n",
        "        CREATE TABLE IF NOT EXISTS RiwayatServis (\n",
        "            id INTEGER PRIMARY KEY AUTOINCREMENT,\n",
        "            id_kendaraan INTEGER NOT NULL,\n",
        "            jenis_servis TEXT NOT NULL,\n",
        "            tanggal_servis TEXT NOT NULL,\n",
        "            km_saat_servis INTEGER NOT NULL,\n",
        "            biaya INTEGER NOT NULL,\n",
        "            km_target_berikutnya INTEGER NOT NULL,\n",
        "            catatan TEXT,\n",
        "            FOREIGN KEY (id_kendaraan) REFERENCES Kendaraan(id) ON DELETE CASCADE\n",
        "        )\n",
        "    \"\"\")\n",
        "\n",
        "    conn.commit()\n",
        "    conn.close()\n",
        "\n",
        "\n",
        "# ==================================================\n",
        "# FUNGSI BANTUAN\n",
        "# ==================================================\n",
        "\n",
        "def hash_password(password: str, salt: str | None = None) -> str:\n",
        "    if salt is None:\n",
        "        salt = os.urandom(16).hex()\n",
        "    digest = hashlib.pbkdf2_hmac(\n",
        "        \"sha256\",\n",
        "        password.encode(\"utf-8\"),\n",
        "        salt.encode(\"utf-8\"),\n",
        "        100_000,\n",
        "    ).hex()\n",
        "    return f\"{salt}${digest}\"\n",
        "\n",
        "\n",
        "def verify_password(password: str, stored_hash: str) -> bool:\n",
        "    if \"$\" not in stored_hash:\n",
        "        return password == stored_hash\n",
        "    salt, _ = stored_hash.split(\"$\", 1)\n",
        "    return hash_password(password, salt) == stored_hash\n",
        "\n",
        "\n",
        "def interval_servis(jenis: str) -> int:\n",
        "    aturan = {\n",
        "        \"Ganti Oli\": 2000,\n",
        "        \"Oli Gardan\": 5000,\n",
        "        \"Tune Up\": 8000,\n",
        "        \"Kampas Rem\": 10000,\n",
        "        \"Ban\": 20000,\n",
        "    }\n",
        "    return aturan.get(jenis, 0)\n",
        "\n",
        "\n",
        "def input_angka(pesan: str, minimum: int = 0) -> int:\n",
        "    while True:\n",
        "        try:\n",
        "            angka = int(input(pesan))\n",
        "            if angka < minimum:\n",
        "                print(f\"❌ Angka minimal adalah {minimum}!\")\n",
        "                continue\n",
        "            return angka\n",
        "        except ValueError:\n",
        "            print(\"❌ Masukkan angka yang valid!\")\n",
        "\n",
        "\n",
        "def input_teks(pesan: str) -> str:\n",
        "    while True:\n",
        "        teks = input(pesan).strip()\n",
        "        if teks:\n",
        "            return teks\n",
        "        print(\"❌ Data tidak boleh kosong!\")\n",
        "\n",
        "\n",
        "def input_tanggal() -> str:\n",
        "    today = datetime.now().date()\n",
        "    while True:\n",
        "        tanggal = input(\"Tanggal Servis (DD-MM-YYYY): \").strip()\n",
        "        try:\n",
        "            parsed = datetime.strptime(tanggal, \"%d-%m-%Y\").date()\n",
        "            if parsed > today:\n",
        "                print(\"❌ Tanggal servis tidak boleh melebihi hari ini!\")\n",
        "                continue\n",
        "            return tanggal\n",
        "        except ValueError:\n",
        "            print(\"❌ Format tanggal tidak valid! Gunakan DD-MM-YYYY.\")\n",
        "\n",
        "\n",
        "def pilih_kendaraan_user(user_id: int):\n",
        "    \"\"\"Menampilkan kendaraan milik user dan mengembalikan tuple (id_kendaraan, km_saat_ini) atau None.\"\"\"\n",
        "    valid_ids = lihat_kendaraan(user_id)\n",
        "    if not valid_ids:\n",
        "        return None\n",
        "\n",
        "    while True:\n",
        "        id_kendaraan = input_angka(\"\\nMasukkan ID Kendaraan (0 untuk batal): \", 0)\n",
        "        if id_kendaraan == 0:\n",
        "            return None\n",
        "        if id_kendaraan not in valid_ids:\n",
        "            print(\"❌ ID kendaraan tidak ditemukan pada akun Anda!\")\n",
        "            continue\n",
        "\n",
        "        conn = get_conn()\n",
        "        cursor = conn.cursor()\n",
        "        cursor.execute(\n",
        "            \"\"\"\n",
        "            SELECT kilometer_saat_ini\n",
        "            FROM Kendaraan\n",
        "            WHERE id = ? AND user_id = ?\n",
        "            \"\"\",\n",
        "            (id_kendaraan, user_id),\n",
        "        )\n",
        "        hasil = cursor.fetchone()\n",
        "        conn.close()\n",
        "\n",
        "        if hasil:\n",
        "            return id_kendaraan, hasil[0]\n",
        "\n",
        "\n",
        "def ambil_status_servis(id_kendaraan: int, km_ini: int):\n",
        "    \"\"\"Mengambil servis terakhir per jenis dan menghitung sisa KM.\"\"\"\n",
        "    conn = get_conn()\n",
        "    cursor = conn.cursor()\n",
        "    cursor.execute(\n",
        "        \"\"\"\n",
        "        SELECT jenis_servis, km_target_berikutnya, tanggal_servis\n",
        "        FROM RiwayatServis\n",
        "        WHERE id_kendaraan = ?\n",
        "        ORDER BY id DESC\n",
        "        \"\"\",\n",
        "        (id_kendaraan,),\n",
        "    )\n",
        "    data = cursor.fetchall()\n",
        "    conn.close()\n",
        "\n",
        "    if not data:\n",
        "        return None\n",
        "\n",
        "    servis_terakhir = {}\n",
        "    for jenis, target, tanggal in data:\n",
        "        if jenis not in servis_terakhir:\n",
        "            sisa = target - km_ini\n",
        "            if sisa > 500:\n",
        "                status_kode = \"AMAN\"\n",
        "            elif sisa >= 0:\n",
        "                status_kode = \"SEGERA\"\n",
        "            else:\n",
        "                status_kode = \"TERLAMBAT\"\n",
        "\n",
        "            servis_terakhir[jenis] = {\n",
        "                \"target\": target,\n",
        "                \"tanggal\": tanggal,\n",
        "                \"sisa\": sisa,\n",
        "                \"status\": status_kode,\n",
        "            }\n",
        "\n",
        "    return servis_terakhir\n",
        "\n",
        "\n",
        "# ==================================================\n",
        "# FUNGSI AUTENTIKASI\n",
        "# ==================================================\n",
        "\n",
        "def registrasi():\n",
        "    print(\"\\n========== REGISTRASI AKUN ==========\")\n",
        "\n",
        "    nama = input_teks(\"Nama Lengkap : \")\n",
        "    username = input_teks(\"Username    : \")\n",
        "    password = input_teks(\"Password    : \")\n",
        "\n",
        "    if len(password) < 6:\n",
        "        print(\"❌ Password minimal 6 karakter!\")\n",
        "        return\n",
        "\n",
        "    password_hashed = hash_password(password)\n",
        "\n",
        "    conn = get_conn()\n",
        "    cursor = conn.cursor()\n",
        "\n",
        "    try:\n",
        "        cursor.execute(\n",
        "            \"\"\"\n",
        "            INSERT INTO User (nama, username, password)\n",
        "            VALUES (?, ?, ?)\n",
        "            \"\"\",\n",
        "            (nama, username, password_hashed),\n",
        "        )\n",
        "        conn.commit()\n",
        "        print(\"\\n✅ Registrasi berhasil!\")\n",
        "        print(\"Silakan login menggunakan akun Anda.\")\n",
        "    except sqlite3.IntegrityError:\n",
        "        print(\"\\n❌ Username sudah digunakan!\")\n",
        "    finally:\n",
        "        conn.close()\n",
        "\n",
        "\n",
        "def login():\n",
        "    print(\"\\n========== LOGIN ==========\")\n",
        "\n",
        "    username = input_teks(\"Username : \")\n",
        "    password = input_teks(\"Password : \")\n",
        "\n",
        "    conn = get_conn()\n",
        "    cursor = conn.cursor()\n",
        "    cursor.execute(\n",
        "        \"\"\"\n",
        "        SELECT id, nama, password\n",
        "        FROM User\n",
        "        WHERE username = ?\n",
        "        \"\"\",\n",
        "        (username,),\n",
        "    )\n",
        "    user = cursor.fetchone()\n",
        "    conn.close()\n",
        "\n",
        "    if user and verify_password(password, user[2]):\n",
        "        print(\"\\n✅ Login berhasil!\")\n",
        "        print(f\"Selamat datang, {user[1]}!\")\n",
        "        return user[0]\n",
        "\n",
        "    print(\"\\n❌ Username atau password salah!\")\n",
        "    return None\n",
        "\n",
        "\n",
        "# ==================================================\n",
        "# KELOLA KENDARAAN\n",
        "# ==================================================\n",
        "\n",
        "def tambah_kendaraan(user_id: int):\n",
        "    print(\"\\n========== TAMBAH KENDARAAN ==========\")\n",
        "\n",
        "    nopol = input_teks(\"Nomor Polisi       : \").upper()\n",
        "    merk = input_teks(\"Merk Motor         : \")\n",
        "    tipe = input_teks(\"Tipe Motor         : \")\n",
        "    tahun = input_angka(\"Tahun Kendaraan    : \", 1900)\n",
        "\n",
        "    if tahun > datetime.now().year:\n",
        "        print(\"❌ Tahun kendaraan tidak boleh melebihi tahun sekarang!\")\n",
        "        return\n",
        "\n",
        "    km = input_angka(\"Kilometer Saat Ini : \")\n",
        "\n",
        "    conn = get_conn()\n",
        "    cursor = conn.cursor()\n",
        "    cursor.execute(\n",
        "        \"\"\"\n",
        "        INSERT INTO Kendaraan\n",
        "        (user_id, nomor_polisi, merk, tipe, tahun, kilometer_saat_ini)\n",
        "        VALUES (?, ?, ?, ?, ?, ?)\n",
        "        \"\"\",\n",
        "        (user_id, nopol, merk, tipe, tahun, km),\n",
        "    )\n",
        "    conn.commit()\n",
        "    conn.close()\n",
        "\n",
        "    print(\"\\n✅ Kendaraan berhasil ditambahkan!\")\n",
        "\n",
        "\n",
        "def lihat_kendaraan(user_id: int) -> list[int]:\n",
        "    print(\"\\n========== DAFTAR KENDARAAN ==========\")\n",
        "\n",
        "    conn = get_conn()\n",
        "    cursor = conn.cursor()\n",
        "    cursor.execute(\n",
        "        \"\"\"\n",
        "        SELECT id, nomor_polisi, merk, tipe, tahun, kilometer_saat_ini\n",
        "        FROM Kendaraan\n",
        "        WHERE user_id = ?\n",
        "        ORDER BY id\n",
        "        \"\"\",\n",
        "        (user_id,),\n",
        "    )\n",
        "    kendaraan = cursor.fetchall()\n",
        "    conn.close()\n",
        "\n",
        "    if not kendaraan:\n",
        "        print(\"⚠️ Belum ada data kendaraan.\")\n",
        "        return []\n",
        "\n",
        "    print(\"-\" * 85)\n",
        "    print(\n",
        "        f\"{'ID':<4} {'No Polisi':<14} {'Merk':<12} \"\n",
        "        f\"{'Tipe':<15} {'Tahun':<8} {'KM':<10}\"\n",
        "    )\n",
        "    print(\"-\" * 85)\n",
        "\n",
        "    valid_ids = []\n",
        "    for k in kendaraan:\n",
        "        valid_ids.append(k[0])\n",
        "        print(\n",
        "            f\"{k[0]:<4} {k[1]:<14} {k[2]:<12} \"\n",
        "            f\"{k[3]:<15} {k[4]:<8} {k[5]:<10,}\"\n",
        "        )\n",
        "\n",
        "    print(\"-\" * 85)\n",
        "    return valid_ids\n",
        "\n",
        "\n",
        "def update_kilometer(user_id: int):\n",
        "    print(\"\\n========== UPDATE KILOMETER ==========\")\n",
        "\n",
        "    selected = pilih_kendaraan_user(user_id)\n",
        "    if not selected:\n",
        "        return\n",
        "\n",
        "    id_kendaraan, km_lama = selected\n",
        "    km_baru = input_angka(\"Kilometer Baru      : \")\n",
        "\n",
        "    if km_baru < km_lama:\n",
        "        print(\"❌ Kilometer tidak boleh berkurang!\")\n",
        "        print(f\"KM sebelumnya: {km_lama:,}\")\n",
        "        return\n",
        "\n",
        "    conn = get_conn()\n",
        "    cursor = conn.cursor()\n",
        "    cursor.execute(\n",
        "        \"\"\"\n",
        "        UPDATE Kendaraan\n",
        "        SET kilometer_saat_ini = ?\n",
        "        WHERE id = ? AND user_id = ?\n",
        "        \"\"\",\n",
        "        (km_baru, id_kendaraan, user_id),\n",
        "    )\n",
        "    conn.commit()\n",
        "    conn.close()\n",
        "\n",
        "    print(\"\\n✅ Kilometer berhasil diperbarui!\")\n",
        "    print(f\"KM Lama : {km_lama:,}\")\n",
        "    print(f\"KM Baru : {km_baru:,}\")\n",
        "\n",
        "\n",
        "# ==================================================\n",
        "# RIWAYAT SERVIS\n",
        "# ==================================================\n",
        "\n",
        "def tambah_servis(user_id: int):\n",
        "    print(\"\\n========== TAMBAH RIWAYAT SERVIS ==========\")\n",
        "\n",
        "    selected = pilih_kendaraan_user(user_id)\n",
        "    if not selected:\n",
        "        return\n",
        "\n",
        "    id_kendaraan, km_sekarang = selected\n",
        "\n",
        "    print(\"\\n========== PILIH JENIS SERVIS ==========\")\n",
        "    print(\"1. Ganti Oli       (2000 KM)\")\n",
        "    print(\"2. Oli Gardan      (5000 KM)\")\n",
        "    print(\"3. Tune Up         (8000 KM)\")\n",
        "    print(\"4. Kampas Rem      (10000 KM)\")\n",
        "    print(\"5. Ban             (20000 KM)\")\n",
        "\n",
        "    pilihan = input(\"Pilih Servis (1-5): \").strip()\n",
        "\n",
        "    daftar = {\n",
        "        \"1\": \"Ganti Oli\",\n",
        "        \"2\": \"Oli Gardan\",\n",
        "        \"3\": \"Tune Up\",\n",
        "        \"4\": \"Kampas Rem\",\n",
        "        \"5\": \"Ban\",\n",
        "    }\n",
        "\n",
        "    jenis = daftar.get(pilihan)\n",
        "    if not jenis:\n",
        "        print(\"❌ Pilihan tidak valid!\")\n",
        "        return\n",
        "\n",
        "    tanggal = input_tanggal()\n",
        "    km_servis = input_angka(\"KM Saat Servis : \")\n",
        "    biaya = input_angka(\"Biaya Servis   : \")\n",
        "    catatan = input(\"Catatan        : \").strip()\n",
        "\n",
        "    target = km_servis + interval_servis(jenis)\n",
        "    km_terbaru = max(km_sekarang, km_servis)\n",
        "\n",
        "    conn = get_conn()\n",
        "    cursor = conn.cursor()\n",
        "\n",
        "    cursor.execute(\n",
        "        \"\"\"\n",
        "        INSERT INTO RiwayatServis\n",
        "        (\n",
        "            id_kendaraan,\n",
        "            jenis_servis,\n",
        "            tanggal_servis,\n",
        "            km_saat_servis,\n",
        "            biaya,\n",
        "            km_target_berikutnya,\n",
        "            catatan\n",
        "        )\n",
        "        VALUES (?, ?, ?, ?, ?, ?, ?)\n",
        "        \"\"\",\n",
        "        (\n",
        "            id_kendaraan,\n",
        "            jenis,\n",
        "            tanggal,\n",
        "            km_servis,\n",
        "            biaya,\n",
        "            target,\n",
        "            catatan,\n",
        "        ),\n",
        "    )\n",
        "\n",
        "    if km_terbaru > km_sekarang:\n",
        "        cursor.execute(\n",
        "            \"\"\"\n",
        "            UPDATE Kendaraan\n",
        "            SET kilometer_saat_ini = ?\n",
        "            WHERE id = ? AND user_id = ?\n",
        "            \"\"\",\n",
        "            (km_terbaru, id_kendaraan, user_id),\n",
        "        )\n",
        "\n",
        "    conn.commit()\n",
        "    conn.close()\n",
        "\n",
        "    print(\"\\n✅ SERVIS BERHASIL DICATAT!\")\n",
        "    print(f\"Jenis Servis      : {jenis}\")\n",
        "    print(f\"Tanggal           : {tanggal}\")\n",
        "    print(f\"KM Servis         : {km_servis:,}\")\n",
        "    print(f\"Biaya             : Rp {biaya:,}\")\n",
        "    print(f\"Target Berikutnya : {target:,} KM\")\n",
        "    if km_terbaru > km_sekarang:\n",
        "        print(f\"KM Kendaraan      : Diperbarui menjadi {km_terbaru:,} KM\")\n",
        "\n",
        "\n",
        "# ==================================================\n",
        "# JADWAL & NOTIFIKASI SERVIS\n",
        "# ==================================================\n",
        "\n",
        "def jadwal_servis(user_id: int):\n",
        "    print(\"\\n========== JADWAL SERVIS BERIKUTNYA ==========\")\n",
        "\n",
        "    selected = pilih_kendaraan_user(user_id)\n",
        "    if not selected:\n",
        "        return\n",
        "\n",
        "    id_kendaraan, km_ini = selected\n",
        "    status_map = ambil_status_servis(id_kendaraan, km_ini)\n",
        "\n",
        "    if not status_map:\n",
        "        print(\"⚠️ Belum ada riwayat servis!\")\n",
        "        return\n",
        "\n",
        "    print(f\"\\nKM Kendaraan Saat Ini: {km_ini:,} KM\")\n",
        "    print(\"\\nJadwal Servis Berikutnya:\")\n",
        "    print(\"-\" * 60)\n",
        "\n",
        "    for jenis, info in status_map.items():\n",
        "        sisa = info[\"sisa\"]\n",
        "        print(f\"\\nJenis Servis   : {jenis}\")\n",
        "        print(f\"Servis Terakhir: {info['tanggal']}\")\n",
        "        print(f\"Target KM      : {info['target']:,} KM\")\n",
        "\n",
        "        if info[\"status\"] == \"AMAN\":\n",
        "            print(f\"Status         : Masih Aman ({sisa:,} KM lagi)\")\n",
        "        elif info[\"status\"] == \"SEGERA\":\n",
        "            print(f\"Status         : Segera Servis ({sisa:,} KM lagi)\")\n",
        "        else:\n",
        "            print(f\"Status         : Terlambat {abs(sisa):,} KM\")\n",
        "\n",
        "    print(\"-\" * 60)\n",
        "\n",
        "\n",
        "def notifikasi_servis(user_id: int):\n",
        "    print(\"\\n========== NOTIFIKASI SERVIS ==========\")\n",
        "\n",
        "    selected = pilih_kendaraan_user(user_id)\n",
        "    if not selected:\n",
        "        return\n",
        "\n",
        "    id_kendaraan, km_ini = selected\n",
        "    status_map = ambil_status_servis(id_kendaraan, km_ini)\n",
        "\n",
        "    if not status_map:\n",
        "        print(\"⚠️ Belum ada riwayat servis!\")\n",
        "        return\n",
        "\n",
        "    print(f\"\\nKM Kendaraan Saat Ini: {km_ini:,} KM\")\n",
        "    print(\"\\n========== STATUS NOTIFIKASI ==========\")\n",
        "\n",
        "    for jenis, info in status_map.items():\n",
        "        sisa = info[\"sisa\"]\n",
        "        print(f\"\\n🔧 Jenis Servis : {jenis}\")\n",
        "        print(f\"🎯 Target       : {info['target']:,} KM\")\n",
        "\n",
        "        if info[\"status\"] == \"AMAN\":\n",
        "            print(\"✅ STATUS: MASIH AMAN\")\n",
        "            print(f\"Sisa: {sisa:,} KM lagi\")\n",
        "        elif info[\"status\"] == \"SEGERA\":\n",
        "            print(\"⚠️ STATUS: SEGERA SERVIS\")\n",
        "            print(f\"Sisa: {sisa:,} KM lagi\")\n",
        "        else:\n",
        "            print(\"🚨 STATUS: TERLAMBAT SERVIS\")\n",
        "            print(f\"Keterlambatan: {abs(sisa):,} KM\")\n",
        "\n",
        "\n",
        "# ==================================================\n",
        "# LAPORAN KENDARAAN\n",
        "# ==================================================\n",
        "\n",
        "def laporan_kendaraan(user_id: int):\n",
        "    print(\"\\n========== LAPORAN KENDARAAN ==========\")\n",
        "\n",
        "    selected = pilih_kendaraan_user(user_id)\n",
        "    if not selected:\n",
        "        return\n",
        "\n",
        "    id_kendaraan, _ = selected\n",
        "\n",
        "    conn = get_conn()\n",
        "    cursor = conn.cursor()\n",
        "\n",
        "    cursor.execute(\n",
        "        \"\"\"\n",
        "        SELECT nomor_polisi, merk, tipe, tahun, kilometer_saat_ini\n",
        "        FROM Kendaraan\n",
        "        WHERE id = ? AND user_id = ?\n",
        "        \"\"\",\n",
        "        (id_kendaraan, user_id),\n",
        "    )\n",
        "    kendaraan = cursor.fetchone()\n",
        "\n",
        "    if not kendaraan:\n",
        "        print(\"❌ Kendaraan tidak ditemukan!\")\n",
        "        conn.close()\n",
        "        return\n",
        "\n",
        "    nopol, merk, tipe, tahun, km_ini = kendaraan\n",
        "\n",
        "    cursor.execute(\n",
        "        \"\"\"\n",
        "        SELECT tanggal_servis, jenis_servis, km_saat_servis, biaya, catatan\n",
        "        FROM RiwayatServis\n",
        "        WHERE id_kendaraan = ?\n",
        "        ORDER BY id ASC\n",
        "        \"\"\",\n",
        "        (id_kendaraan,),\n",
        "    )\n",
        "    riwayat = cursor.fetchall()\n",
        "\n",
        "    cursor.execute(\n",
        "        \"\"\"\n",
        "        SELECT jenis_servis, km_target_berikutnya\n",
        "        FROM RiwayatServis\n",
        "        WHERE id_kendaraan = ?\n",
        "        ORDER BY id DESC\n",
        "        LIMIT 1\n",
        "        \"\"\",\n",
        "        (id_kendaraan,),\n",
        "    )\n",
        "    servis_terakhir = cursor.fetchone()\n",
        "    conn.close()\n",
        "\n",
        "    total_servis = len(riwayat)\n",
        "    total_biaya = sum(r[3] for r in riwayat)\n",
        "    rata_rata = total_biaya // total_servis if total_servis > 0 else 0\n",
        "\n",
        "    jenis_count = {}\n",
        "    for r in riwayat:\n",
        "        jenis_count[r[1]] = jenis_count.get(r[1], 0) + 1\n",
        "\n",
        "    terbanyak = (\n",
        "        max(jenis_count.items(), key=lambda x: x[1])\n",
        "        if jenis_count\n",
        "        else (\"-\", 0)\n",
        "    )\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 50)\n",
        "    print(\"              CARE MOTOR\")\n",
        "    print(\"             LAPORAN KENDARAAN\")\n",
        "    print(\"=\" * 50)\n",
        "\n",
        "    print(f\"Nomor Polisi    : {nopol}\")\n",
        "    print(f\"Merk Motor      : {merk}\")\n",
        "    print(f\"Tipe Motor      : {tipe}\")\n",
        "    print(f\"Tahun           : {tahun}\")\n",
        "    print(f\"KM Saat Ini     : {km_ini:,} KM\")\n",
        "\n",
        "    print(\"-\" * 50)\n",
        "\n",
        "    print(f\"Total Servis    : {total_servis} kali\")\n",
        "    print(f\"Total Biaya     : Rp {total_biaya:,}\")\n",
        "    print(f\"Rata-rata       : Rp {rata_rata:,}\")\n",
        "\n",
        "    if servis_terakhir:\n",
        "        print(f\"Servis Terakhir : {servis_terakhir[0]}\")\n",
        "        print(f\"Target Servis   : {servis_terakhir[1]:,} KM\")\n",
        "\n",
        "    print(f\"Servis Terbanyak: {terbanyak[0]}\")\n",
        "    print(f\"Jumlah          : {terbanyak[1]} kali\")\n",
        "\n",
        "    print(\"=\" * 50)\n",
        "\n",
        "    if riwayat:\n",
        "        print(\"\\n========== RIWAYAT SERVIS ==========\")\n",
        "        print(\n",
        "            f\"{'Tanggal':<12} | {'Jenis Servis':<15} | \"\n",
        "            f\"{'KM':<10} | {'Biaya':<15} | {'Catatan'}\"\n",
        "        )\n",
        "        print(\"-\" * 80)\n",
        "\n",
        "        for r in riwayat:\n",
        "            catatan_tampil = r[4] if r[4] else \"-\"\n",
        "            print(\n",
        "                f\"{r[0]:<12} | {r[1]:<15} | \"\n",
        "                f\"{r[2]:<10,} | Rp {r[3]:<12,} | {catatan_tampil}\"\n",
        "            )\n",
        "    else:\n",
        "        print(\"\\n⚠️ Belum ada riwayat servis kendaraan.\")\n",
        "\n",
        "\n",
        "# ==================================================\n",
        "# MENU UTAMA\n",
        "# ==================================================\n",
        "\n",
        "def menu_utama(user_id: int):\n",
        "    while True:\n",
        "        print(\"\\n\" + \"=\" * 45)\n",
        "        print(\"             CARE MOTOR\")\n",
        "        print(\"               MENU UTAMA\")\n",
        "        print(\"=\" * 45)\n",
        "\n",
        "        print(\"1. Tambah Kendaraan\")\n",
        "        print(\"2. Lihat Data Kendaraan\")\n",
        "        print(\"3. Update Kilometer\")\n",
        "        print(\"4. Tambah Riwayat Servis\")\n",
        "        print(\"5. Lihat Jadwal Servis Berikutnya\")\n",
        "        print(\"6. Cek Notifikasi Servis\")\n",
        "        print(\"7. Laporan Kendaraan\")\n",
        "        print(\"8. Logout\")\n",
        "\n",
        "        print(\"=\" * 45)\n",
        "\n",
        "        pilihan = input(\"Pilih Menu (1-8): \").strip()\n",
        "\n",
        "        if pilihan == \"1\":\n",
        "            tambah_kendaraan(user_id)\n",
        "        elif pilihan == \"2\":\n",
        "            lihat_kendaraan(user_id)\n",
        "        elif pilihan == \"3\":\n",
        "            update_kilometer(user_id)\n",
        "        elif pilihan == \"4\":\n",
        "            tambah_servis(user_id)\n",
        "        elif pilihan == \"5\":\n",
        "            jadwal_servis(user_id)\n",
        "        elif pilihan == \"6\":\n",
        "            notifikasi_servis(user_id)\n",
        "        elif pilihan == \"7\":\n",
        "            laporan_kendaraan(user_id)\n",
        "        elif pilihan == \"8\":\n",
        "            print(\"\\n👋 Berhasil Logout!\")\n",
        "            print(\"Terima kasih telah menggunakan CARE MOTOR.\")\n",
        "            break\n",
        "        else:\n",
        "            print(\"\\n❌ Pilihan tidak valid! Pilih menu 1-8.\")\n",
        "\n",
        "\n",
        "# ==================================================\n",
        "# MENU AWAL / MAIN PROGRAM\n",
        "# ==================================================\n",
        "\n",
        "def main():\n",
        "    buat_database()\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 50)\n",
        "    print(\"           🛵 APLIKASI CARE-MOTOR 🛵\")\n",
        "    print(\"  Computerized Automotive Reminder\")\n",
        "    print(\"       and Maintenance Tracker\")\n",
        "    print(\"=\" * 50)\n",
        "\n",
        "    while True:\n",
        "        print(\"\\n========== MENU AWAL ==========\")\n",
        "        print(\"1. Registrasi Akun Baru\")\n",
        "        print(\"2. Login ke Akun\")\n",
        "        print(\"3. Keluar dari Program\")\n",
        "        print(\"===============================\")\n",
        "\n",
        "        pilih = input(\"Masukkan Pilihan (1-3): \").strip()\n",
        "\n",
        "        if pilih == \"1\":\n",
        "            registrasi()\n",
        "        elif pilih == \"2\":\n",
        "            user_id = login()\n",
        "            if user_id is not None:\n",
        "                menu_utama(user_id)\n",
        "        elif pilih == \"3\":\n",
        "            print(\"\\n================================\")\n",
        "            print(\"Terima kasih telah menggunakan\")\n",
        "            print(\"       APLIKASI CARE-MOTOR\")\n",
        "            print(\"================================\")\n",
        "            print(\"Program selesai.\")\n",
        "            break\n",
        "        else:\n",
        "            print(\"❌ Pilihan tidak valid! Pilih 1-3.\")\n",
        "\n",
        "\n",
        "# ==================================================\n",
        "# MENJALANKAN PROGRAM\n",
        "# ==================================================\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    try:\n",
        "        main()\n",
        "    except KeyboardInterrupt:\n",
        "        print(\"\\n\\nProgram dihentikan oleh pengguna.\")\n",
        "    except sqlite3.Error as error:\n",
        "        print(f\"\\nTerjadi kesalahan database: {error}\")"
      ]
    }
  ]
}